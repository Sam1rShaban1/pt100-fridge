# ---- Domain (used for grafana.example.com / ota.example.com / mqtt.example.com) ----
DOMAIN=example.com

# ---- InfluxDB 3 Core ----
INFLUX_TOKEN=change-me-inflx-token
INFLUXDB_DATABASE=pt100

# ---- Grafana ----
GRAFANA_PASSWORD=admin

# ---- MQTT broker (Mosquitto) ----
MQTT_ADMIN_PASS=change-me-mqtt-admin
MQTT_TELEGRAF_PASS=change-me-mqtt-telegraf

# ---- OTA server ----
OTA_ADMIN_TOKEN=change-me-ota-admin
PUBLIC_BASE_URL=https://ota.example.com

# Device groups used for staged rollouts. The server targets these exact
# device IDs; add one entry per physical device you flash.
DEVICE_GROUPS={"zone_a":["fridge-001","fridge-002"],"zone_b":["fridge-003"]}
